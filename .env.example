UNMEET_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/unmeet

INGESTION_SOURCES=hackernews,github
INGESTION_FAIL_FAST=true

HACKERNEWS_FEEDS=askstories,topstories,newstories
HACKERNEWS_LIMIT=500
HACKERNEWS_MAX_WORKERS=16
HACKERNEWS_INCLUDE_COMMENTS=true
HACKERNEWS_MAX_COMMENTS_PER_STORY=20

GITHUB_TOKEN=
GITHUB_REPOSITORIES=microsoft/vscode,langchain-ai/langchain,pallets/flask
GITHUB_ISSUES_LIMIT=1000
GITHUB_ISSUES_STATE=all
GITHUB_ISSUES_SORT=updated

STACKEXCHANGE_SITE=stackoverflow

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=unMeet/0.1

# Classifier: "qwen3" (local, binary) or "llm" (OpenAI-compatible API, extracts signals)
CLASSIFIER_BACKEND=llm
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_USE_JSON_SCHEMA=false

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
