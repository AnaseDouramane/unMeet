UNMEET_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/unmeet

INGESTION_SOURCES=hackernews,github
INGESTION_FAIL_FAST=true

# Algolia search (INGESTION_SOURCES=hackernews_search): `tag` or `tag:query`, separated by ;
# tags: comment, story, ask_hn, show_hn. Example: ask_hn;comment:duplicate contacts
HACKERNEWS_SEARCHES=ask_hn
# Stack Exchange (INGESTION_SOURCES=stackexchange): STACKEXCHANGE_SITE below, optional ;-separated queries
STACKEXCHANGE_QUERIES=
STACKEXCHANGE_KEY=
HACKERNEWS_FEEDS=askstories,topstories,newstories
HACKERNEWS_LIMIT=500
HACKERNEWS_MAX_WORKERS=16
HACKERNEWS_INCLUDE_COMMENTS=true
HACKERNEWS_MAX_COMMENTS_PER_STORY=20

GITHUB_TOKEN=
GITHUB_REPOSITORIES=microsoft/vscode,langchain-ai/langchain,pallets/flask
GITHUB_ISSUES_LIMIT=1000
GITHUB_ISSUES_STATE=all
GITHUB_ISSUES_SORT=updated

STACKEXCHANGE_SITE=stackoverflow

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=unMeet/0.2 (by /u/your_username)
REDDIT_SUBREDDITS=sales,SaaS,startups,coldemail,revops

# Classifier: "qwen3" (local, binary) or "llm" (OpenAI-compatible API, extracts signals)
CLASSIFIER_BACKEND=llm
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_USE_JSON_SCHEMA=false
CLASSIFICATION_WORKERS=8
# Embed first and call the LLM only for items near an active topic (no topics = no filtering).
TOPIC_GATE_ENABLED=true
# Worker (python -m scripts.run_worker): poll every source on this interval, with backoff.
POLL_INTERVAL_SECONDS=600
POLL_MAX_BACKOFF_SECONDS=3600
POLL_STALL_AFTER_SECONDS=10800
# Texts per LLM request (1 = one request per text). 5-8 cuts request count and cost.
CLASSIFICATION_BATCH_SIZE=1
# Cluster labels: "keywords" (TF-IDF) or "llm" (one-sentence problem statements)
LABELING_BACKEND=llm

# Required for write endpoints outside development (Authorization: Bearer <key>)
UNMEET_API_KEY=

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM cost tracking: tokens are always counted; set prices (USD per million tokens) to get cost.
LLM_USAGE_TRACKING=true
LLM_INPUT_USD_PER_MTOK=
LLM_OUTPUT_USD_PER_MTOK=
# API protection and logging
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_WRITE_PER_MINUTE=30
TRUST_PROXY_HEADERS=false
LOG_FORMAT=text
# GDPR: how long items are kept (measured from when they were processed)
RETENTION_NON_SIGNAL_DAYS=30
RETENTION_SIGNAL_DAYS=365
PRIVACY_CONTACT_EMAIL=
# /health/ingestion returns 503 when a source with data was not processed for this long
INGESTION_STALE_AFTER_SECONDS=21600
